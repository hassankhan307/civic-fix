# ====================================================================
# CivicFix Environment Configuration Template
# ====================================================================

# Database Configuration
# Local SQLite fallback: file:./dev.db
# Production PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/civicfix?schema=public
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_ACCESS_SECRET="civicfix_access_jwt_secret_dev_key_2026_secure"
JWT_REFRESH_SECRET="civicfix_refresh_jwt_secret_dev_key_2026_secure"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# Microservices URLs
BACKEND_PORT=5000
FRONTEND_PORT=3000
AI_SERVICE_URL="http://127.0.0.1:8000"
CORS_ORIGIN="http://localhost:3000"

# AI Vision Configuration
# Options: 'local' (offline smart heuristic vision) or 'gemini' (Google Gemini Vision API)
AI_PROVIDER="local"
# Set your Gemini API Key if using 'gemini':
# GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"
CONFIDENCE_THRESHOLD=0.65

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
